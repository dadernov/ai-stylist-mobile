{
  "expo": {
    "name": "AI Стилист",
    "slug": "ai-stylist-mobile",
    "scheme": "aistylist",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aistylist.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Нужно разрешение, чтобы сфотографировать одежду.",
        "NSPhotoLibraryUsageDescription": "Нужно разрешение, чтобы выбрать фото одежды.",
        "NSLocationWhenInUseUsageDescription": "Нужно разрешение, чтобы получить погоду рядом с вами.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "Нужно разрешение, чтобы сохранить результат примерки в галерею."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F5F2"
      },
      "package": "com.aistylist.mobile",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "c0772743-44f5-4023-b30d-673669bbba1d"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/c0772743-44f5-4023-b30d-673669bbba1d"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F5F2",
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
