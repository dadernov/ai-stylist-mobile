{
  "name": "ai-stylist-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:mac": "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" expo start",
    "start:lan:mac": "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" EXPO_PUBLIC_AI_BASE_URL=https://62.60.238.183.nip.io expo start -c --lan --port 8081",
    "start:tunnel:mac": "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" EXPO_PUBLIC_AI_BASE_URL=https://62.60.238.183.nip.io expo start -c --tunnel --port 8081",
    "start:proxy-tunnel:mac": "bash ./scripts/start-proxy-tunnel-mac.sh",
    "share:ios": "bash ./scripts/start-proxy-tunnel-mac.sh",
    "build:ios:development": "eas build --platform ios --profile development",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:production": "eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node tests/outfits.cjs && node tests/storage.cjs && node tests/crop.cjs && node tests/account-jobs.cjs && node tests/modal-safe-area.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.34",
    "expo-blur": "~15.0.8",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.17",
    "lucide-react-native": "^1.46.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "^0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "overrides": {
    "metro": "0.83.8",
    "metro-babel-transformer": "0.83.8",
    "metro-cache": "0.83.8",
    "metro-cache-key": "0.83.8",
    "metro-config": "0.83.8",
    "metro-core": "0.83.8",
    "metro-file-map": "0.83.8",
    "metro-minify-terser": "0.83.8",
    "metro-resolver": "0.83.8",
    "metro-runtime": "0.83.8",
    "metro-source-map": "0.83.8",
    "metro-symbolicate": "0.83.8",
    "metro-transform-plugins": "0.83.8",
    "metro-transform-worker": "0.83.8",
    "postcss": "8.5.28",
    "uuid": "11.1.1",
    "ws@7": "7.5.11"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
