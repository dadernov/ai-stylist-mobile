[Unit]
Description=Wardrobe AI server
After=network.target

[Service]
User=root
WorkingDirectory=__APP_DIR__
EnvironmentFile=__ENV_FILE__
Environment="PATH=__APP_DIR__/.venv/bin"
ExecStart=__APP_DIR__/.venv/bin/uvicorn app:app --host 0.0.0.0 --port __PORT__
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
