# Копия -> /etc/wardrobe-ai.env (chmod 600). Формат systemd EnvironmentFile: KEY=VALUE, без export.

# --- обязательное ---
FASHN_API_KEY=ЗАПОЛНИ_МЕНЯ

# --- генеративная примерка (FASHN) ---
# Модель tryon-max закреплена в tryon_policy.py. Каждая вещь — отдельный вызов.
# Два профиля: черновик по умолчанию и финал по кнопке в приложении. Цена вызова
# в кредитах берётся из таблицы FASHN в tryon_policy.CREDITS, её не нужно задавать:
#   fast 1k = 1, fast 2k = 2, balanced 2k = 3, quality 2k = 4, quality 4k = 5.
# Если черновики на живых фото окажутся слишком грубыми, подними их здесь,
# например до balanced 2k (3 кредита) — без выпуска приложения.
FASHN_DRAFT_MODE=fast
FASHN_DRAFT_RESOLUTION=1k
FASHN_FINAL_MODE=quality
FASHN_FINAL_RESOLUTION=2k
# Старые FAST/MODE/GENERATION_MODE/FACE_LOCK переменные на примерку не влияют.
FASHN_QUALITY_MAX_WAIT_SECONDS=240
FASHN_IMAGE_MAX_SIDE=2048
# Модель защиты лица скачивается install.sh, отключить защиту нельзя.
# AI_FACE_MODEL=/opt/wardrobe/ai-server/models/face/yunet.onnx

# --- дешёвая примерка через fal.ai: весь образ одним вызовом (fal_tryon.py) ---
# По умолчанию работает FASHN. Включается двумя строками; откат — убрать TRYON_PROVIDER.
# TRYON_PROVIDER=fal
# FAL_KEY=
# Модель финала и черновика: seedream-5-lite (по умолчанию), bria-tryon, seedream-4.5, seedream-4,
# flux2-klein-9b, qwen-edit-2511.
# TRYON_FAL_MODEL=seedream-5-lite
# TRYON_FAL_DRAFT_MODEL=seedream-5-lite
# Если вещей больше, чем берёт модель (Bria — 3, klein — 3, Qwen — 2), образ идёт сюда, а не в несколько вызовов.
# TRYON_FAL_MANY_MODEL=seedream-5-lite
# Сколько «кредитов» дневного лимита (AI_DAILY_CREDITS) занимает один образ.
# TRYON_FAL_UNITS=1
# TRYON_FAL_MAX_WAIT_SECONDS=180
# TRYON_FAL_SAFETY=true
# face — с фото переносится только лицо (по умолчанию); scene — ещё и фон, как у FASHN.
# TRYON_FAL_RESTORE=face

# --- доступ к платным эндпоинтам ---
# Токены, которые сервер принимает от приложения (через запятую). Пустое
# значение НЕ открывает сервер — оно его закрывает: примерка ответит 503.
# Токен уезжает в сборку приложения, поэтому считай его не секретом, а ключом,
# который можно отозвать здесь, не выпуская новую версию сервера.
AI_CLIENT_TOKENS=
# Сколько кредитов FASHN в сутки может потратить один аккаунт: 80 — это
# 6 финалов из трёх вещей или 26 таких же черновиков. Потолок ущерба от
# утёкшего токена, а не тариф.
AI_DAILY_CREDITS=80
# Потолок счёта за сутки для всего сервиса (800 кредитов ≈ $60 по $0,075).
AI_GLOBAL_DAILY_CREDITS=800
# Старые AI_DEVICE_DAILY_QUOTA и AI_GLOBAL_DAILY_QUOTA считали вызовы; без новых
# переменных они переводятся в кредиты по FASHN_CREDITS_PER_STAGE (4).
# Сколько примерок генерируется одновременно; остальные ждут в очереди и видят
# своё место. Ожидание генератора почти не нагружает сервер, работа с фото —
# несколько секунд процессора на образ.
AI_MAX_ACTIVE_TRYONS=6
# Сколько примерок может ждать всего и сколько из них у одного человека.
AI_MAX_QUEUED_TRYONS=40
AI_MAX_TRYONS_PER_USER=3
AI_JOB_RESULT_MAX_BYTES=268435456
# Где вести учёт. Каталог должен быть доступен на запись пользователю сервиса.
AI_QUOTA_DB=/opt/wardrobe/ai-server/quota.sqlite3
# Промежуточные слои примерки для переиспользования: одна и та же база под
# разными куртками оплачивается один раз. Живут не дольше суток — это обещание
# политики конфиденциальности, больше 86400 задать нельзя.
AI_STAGE_CACHE_DIR=/opt/wardrobe/ai-server/stage-cache
AI_STAGE_CACHE_TTL_SECONDS=86400
AI_STAGE_CACHE_MAX_BYTES=536870912
# Аккаунты: логины, хеши паролей и сессии. Файл с персональными данными —
# бэкапить обязательно, иначе люди потеряют доступ к своим гардеробам.
AI_ACCOUNTS_DB=/opt/wardrobe/ai-server/accounts.sqlite3
# Максимальный размер загружаемого файла.
AI_MAX_UPLOAD_BYTES=15728640
AI_MAX_REQUEST_BYTES=31457280
AI_MAX_IMAGE_PIXELS=25000000
# Браузерные источники для CORS. Мобильному клиенту не нужны — оставь пустым.
AI_ALLOWED_ORIGINS=https://58019781e7eae9e76485bd0dc07c799f.62.60.238.183.nip.io

# --- распознавание вещей ---
# Веса скачивает install.sh через download_analysis_model.py. В рантайме сеть
# не нужна, поэтому HF переводится в офлайн.
HF_HUB_OFFLINE=1
# AI_ANALYSIS_MODEL_DIR=/opt/wardrobe/ai-server/models/clip

# --- прокси (на старом сервере был прописан, но был МЁРТВ; на новом не нужен) ---
# http_proxy=
# https_proxy=
# no_proxy=localhost,127.0.0.1
